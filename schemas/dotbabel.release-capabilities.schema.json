{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dotbabel.dev/schemas/release-capabilities.schema.json",
  "title": "Accepted immutable release capability evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "adapterVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "sourceKind": {
            "enum": ["runtime", "knowledge-source", "artifact"]
          },
          "derivation": {
            "enum": ["declared", "legacy-inferred"]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          }
        },
        "required": ["sourceId", "sourceKind", "sourceVersion", "observedAt"]
      }
    },
    "runtimes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "capabilities": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "reasoning": {
                                "type": "boolean"
                              },
                              "tool_call": {
                                "type": "boolean"
                              },
                              "vision": {
                                "type": "boolean"
                              },
                              "structured_output": {
                                "type": "boolean"
                              },
                              "streaming": {
                                "type": "boolean"
                              }
                            },
                            "required": []
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "supportedReasoningLevels": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "array",
                            "maxItems": 64,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "effort": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "intent": {
                                  "enum": ["low", "medium", "high"]
                                },
                                "order": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 100
                                }
                              },
                              "required": ["effort"],
                              "dependencies": {
                                "intent": ["order"],
                                "order": ["intent"]
                              }
                            },
                            "uniqueItems": true
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "defaultReasoningLevel": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "contextWindow": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "selectionVisibility": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "enum": ["listed", "hidden", "unknown"]
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "inputModalities": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "array",
                            "items": {
                              "enum": ["text", "image", "audio", "video", "pdf"]
                            },
                            "uniqueItems": true
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    },
                    "canonicalModel": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          },
                          "provenance": {
                            "$ref": "#/$defs/provenance"
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "observedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sourceVersion": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "required": ["value", "provenance", "confidence"]
                      }
                    }
                  },
                  "required": ["id"]
                }
              },
              "required": ["model", "fields"]
            }
          },
          "runtimeContract": {
            "type": "object"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        },
        "required": ["models", "runtimeContract", "provenance"]
      }
    }
  },
  "required": ["schemaVersion", "snapshotId", "toolVersion", "sources", "runtimes"],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sourceKind": {
          "enum": ["runtime", "knowledge-source", "artifact"]
        },
        "derivation": {
          "enum": ["declared", "legacy-inferred"]
        }
      },
      "required": ["sourceId", "sourceKind"]
    }
  }
}
