{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotbabel.dev/schemas/dotbabel.config.schema.json",
  "title": "dotbabel project config",
  "description": "Shape of a repo's `.dotbabel.json`, which drives `dotbabel project-sync` and `dotbabel-check-project-sync`. Every key is optional; omitted keys fall back to DEFAULT_PROJECT_CONFIG in plugins/dotbabel/src/project-sync.mjs.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint pointing at this schema."
    },
    "rule_floor_source": {
      "type": "string",
      "description": "Markdown file holding the canonical rule floor that instruction files are generated from.",
      "default": "CLAUDE.md"
    },
    "commands_dir": {
      "type": "string",
      "description": "Directory of Claude command markdown files that fan out to the other CLIs.",
      "default": ".claude/commands"
    },
    "skills_dir": {
      "type": "string",
      "description": "Directory of Claude skill directories that fan out to the other CLIs.",
      "default": ".claude/skills"
    },
    "fan_out": {
      "type": "array",
      "description": "CLIs to fan commands and skills out to. An unknown name is rejected at config load rather than skipped.",
      "default": ["codex", "gemini", "copilot"],
      "items": {
        "type": "string",
        "enum": ["codex", "gemini", "copilot"]
      }
    },
    "fan_out_layout": {
      "type": "string",
      "description": "Whether Codex and Gemini get their own skills trees or share one. 'per-cli' writes .codex/skills/ and .gemini/skills/ as two identical trees. 'shared' writes one canonical tree at .cli/skills/ and points both CLIs at it with a directory symlink, halving the tracked entries. Copilot is unaffected. Switch back to 'per-cli' if a CLI will not follow the redirect.",
      "default": "per-cli",
      "enum": ["per-cli", "shared"]
    },
    "gate_on_cli_presence": {
      "type": "boolean",
      "description": "When true, skip a CLI's symlink fan-out if its binary is absent from PATH. `dotbabel-check-project-sync` honors the same setting, so it will not report the skipped CLI as drift. Pass --all to either binary to override for one run. Instruction files are always written, never gated.",
      "default": true
    },
    "cli_excluded": {
      "type": "object",
      "description": "Per-CLI exclusion list. Maps a CLI name to command basenames (without .md) and skill ids that must not fan out to it, for commands that describe a Claude-only flow. An excluded entry already on disk is removed on the next sync; `dotbabel-check-project-sync` reports it as drift until then. Under fan_out_layout 'shared' an exclusion for codex or gemini applies to both, since they read one tree.",
      "default": {},
      "propertyNames": {
        "enum": ["codex", "gemini", "copilot"]
      },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "cli_substitutions": {
      "type": "object",
      "description": "Per-CLI text substitutions applied while rendering instruction files.",
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "description": "Instruction files to generate from the rule floor.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["relativeOutputPath"],
        "properties": {
          "relativeOutputPath": {
            "type": "string",
            "description": "Repo-relative path of the generated instruction file."
          },
          "cliSet": {
            "type": "array",
            "description": "CLIs this instruction file serves.",
            "items": { "type": "string" }
          },
          "substitutionKey": {
            "type": "string",
            "description": "Key into cli_substitutions used when rendering this target."
          }
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [{ "pattern": "^(?:/|[A-Za-z]:[\\\\/])" }, { "pattern": "(?:^|/)\\.\\.(?:/|$)" }]
      }
    },
    "qualityRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "level": { "enum": ["error", "warning", "info"] },
        "threshold": { "type": "number", "minimum": 0 },
        "scope": { "enum": ["changed", "component", "repository"] },
        "on_unavailable": { "enum": ["error", "warning", "info"] },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["fast", "pr", "deep"] }
        }
      }
    },
    "qualityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "enum": [
            "exit-code",
            "go-coverprofile",
            "coveragepy-json",
            "istanbul-json",
            "lcov",
            "sarif",
            "golangci-json",
            "eslint-json",
            "ruff-json",
            "jscpd-json",
            "stryker-json",
            "dotbabel-v1"
          ]
        },
        "path": { "$ref": "#/$defs/repositoryPath" }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "exit-code" } }, "required": ["format"] },
          "else": { "required": ["path"] }
        }
      ]
    },
    "qualityTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "report": { "$ref": "#/$defs/qualityReport" }
      }
    },
    "qualityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "languages"],
      "properties": {
        "root": { "$ref": "#/$defs/repositoryPath" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "$ref": "#/$defs/qualityTool" },
            "compile": { "$ref": "#/$defs/qualityTool" },
            "typecheck": { "$ref": "#/$defs/qualityTool" },
            "lint": { "$ref": "#/$defs/qualityTool" },
            "test": { "$ref": "#/$defs/qualityTool" },
            "coverage": { "$ref": "#/$defs/qualityTool" },
            "complexity": { "$ref": "#/$defs/qualityTool" },
            "mutation": { "$ref": "#/$defs/qualityTool" },
            "dead-code": { "$ref": "#/$defs/qualityTool" },
            "dependencies": { "$ref": "#/$defs/qualityTool" },
            "duplication": { "$ref": "#/$defs/qualityTool" },
            "security": { "$ref": "#/$defs/qualityTool" },
            "race": { "$ref": "#/$defs/qualityTool" }
          }
        }
      }
    },
    "qualityException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "fingerprint", "reason", "expires"],
      "properties": {
        "id": { "type": "string", "pattern": "^QEX-[0-9]+$" },
        "rule": { "$ref": "#/$defs/qualityRuleId" },
        "fingerprint": { "type": "string", "pattern": "^sha256:" },
        "reason": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "format": "date" },
        "tracking": { "type": "string", "format": "uri" }
      }
    },
    "qualityRuleId": {
      "enum": [
        "correctness.format",
        "correctness.compile",
        "correctness.types",
        "correctness.tests",
        "correctness.lint",
        "security.high_confidence",
        "coverage.no_regression",
        "complexity.cognitive",
        "complexity.cyclomatic",
        "coverage.changed_lines",
        "coverage.changed_branches",
        "mutation.changed_score",
        "duplication.percent",
        "size.function_loc",
        "size.file_loc",
        "maintainability.dead_code",
        "maintainability.unused_dependencies",
        "semantic.ignored_errors",
        "semantic.swallowed_errors",
        "semantic.dynamic_types",
        "semantic.unchecked_assertions",
        "semantic.unbounded_concurrency",
        "semantic.lifecycle",
        "architecture.speculative_abstraction",
        "policy.new_suppression"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "default_profile": { "enum": ["fast", "pr", "deep"], "default": "fast" },
        "base_ref": { "type": "string", "minLength": 1 },
        "baseline_file": { "$ref": "#/$defs/repositoryPath" },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "critical_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "$ref": "#/$defs/qualityRuleId" },
          "properties": {
            "correctness.format": { "$ref": "#/$defs/qualityRule" },
            "correctness.compile": { "$ref": "#/$defs/qualityRule" },
            "correctness.types": { "$ref": "#/$defs/qualityRule" },
            "correctness.tests": { "$ref": "#/$defs/qualityRule" },
            "correctness.lint": { "$ref": "#/$defs/qualityRule" },
            "security.high_confidence": { "$ref": "#/$defs/qualityRule" },
            "coverage.no_regression": { "$ref": "#/$defs/qualityRule" },
            "complexity.cognitive": { "$ref": "#/$defs/qualityRule" },
            "complexity.cyclomatic": { "$ref": "#/$defs/qualityRule" },
            "coverage.changed_lines": { "$ref": "#/$defs/qualityRule" },
            "coverage.changed_branches": { "$ref": "#/$defs/qualityRule" },
            "mutation.changed_score": { "$ref": "#/$defs/qualityRule" },
            "duplication.percent": { "$ref": "#/$defs/qualityRule" },
            "size.function_loc": { "$ref": "#/$defs/qualityRule" },
            "size.file_loc": { "$ref": "#/$defs/qualityRule" },
            "maintainability.dead_code": { "$ref": "#/$defs/qualityRule" },
            "maintainability.unused_dependencies": { "$ref": "#/$defs/qualityRule" },
            "semantic.ignored_errors": { "$ref": "#/$defs/qualityRule" },
            "semantic.swallowed_errors": { "$ref": "#/$defs/qualityRule" },
            "semantic.dynamic_types": { "$ref": "#/$defs/qualityRule" },
            "semantic.unchecked_assertions": { "$ref": "#/$defs/qualityRule" },
            "semantic.unbounded_concurrency": { "$ref": "#/$defs/qualityRule" },
            "semantic.lifecycle": { "$ref": "#/$defs/qualityRule" },
            "architecture.speculative_abstraction": { "$ref": "#/$defs/qualityRule" },
            "policy.new_suppression": { "$ref": "#/$defs/qualityRule" }
          }
        },
        "components": { "type": "array", "items": { "$ref": "#/$defs/qualityComponent" } },
        "exceptions": { "type": "array", "items": { "$ref": "#/$defs/qualityException" } }
      }
    }
  }
}
