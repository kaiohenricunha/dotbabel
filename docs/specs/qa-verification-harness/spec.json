  "acceptance_criteria": [
    {
      "id": "AC-1",
      "status": "planned",
      "given": "a spec.json without acceptance_criteria",
      "when": "dotbabel-validate-specs runs",
      "then": "the spec stays valid",
      "tests": [
        {
          "file": "plugins/dotbabel/tests/validate-specs.test.mjs",
          "name": "accepts a spec without acceptance_criteria"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/validate-specs.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-1.junit.xml"
      ],
      "report": { "format": "junit-xml", "path": ".dotbabel/criteria/AC-1.junit.xml" }
    },
    {
      "id": "AC-2",
      "status": "planned",
      "given": "a criterion without given, when, or then, or with a duplicate id",
      "when": "dotbabel-validate-specs runs",
      "then": "it emits SPEC_CRITERIA_INVALID",
      "tests": [
        {
          "file": "plugins/dotbabel/tests/validate-specs.test.mjs",
          "name": "emits SPEC_CRITERIA_INVALID when a criterion lacks given, when, or then"
        },
        {
          "file": "plugins/dotbabel/tests/validate-specs.test.mjs",
          "name": "emits SPEC_CRITERIA_INVALID for a duplicate criterion id"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/validate-specs.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-2.junit.xml"
      ],
      "report": { "format": "junit-xml", "path": ".dotbabel/criteria/AC-2.junit.xml" }
    },
    {
      "id": "AC-3",
      "status": "planned",
      "given": "a criterion command that exits 0",
      "when": "a named test is missing from the output",
      "then": "the criterion is unconfirmed and does not pass",
      "tests": [
        {
          "file": "plugins/dotbabel/tests/criteria-verify.test.mjs",
          "name": "passes a criterion only when the command exits 0 and every named test is confirmed"
        },
        {
          "file": "plugins/dotbabel/tests/criteria-verify.test.mjs",
          "name": "marks a criterion unconfirmed when the command exits 0 but a named test is missing from the output"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/criteria-verify.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-3.junit.xml"
      ],
      "report": { "format": "junit-xml", "path": ".dotbabel/criteria/AC-3.junit.xml" }
    },
    {
