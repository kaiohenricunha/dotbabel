          "name": "rejects an unknown key inside dotbabel.compute (additionalProperties false)"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/model-intelligence-requirement.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-1.junit.xml"
      ],
      "report": {
        "format": "junit-xml",
        "path": ".dotbabel/criteria/AC-1.junit.xml"
      }
