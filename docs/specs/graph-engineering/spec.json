  "acceptance_criteria": [
    {
      "id": "AC-1",
      "status": "active",
      "given": "a task file with schema_version 1",
      "when": "dotbabel reads it",
      "then": "it reads as version 2 with depends_on []",
      "tests": [
        {
          "file": "plugins/dotbabel/tests/task-state.test.mjs",
          "name": "reads a version-1 task as version 2 with no dependencies"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/task-state.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-1.junit.xml"
      ],
      "report": {
        "format": "junit-xml",
        "path": ".dotbabel/criteria/AC-1.junit.xml"
      }
    },
    {
      "id": "AC-2",
      "status": "active",
      "given": "a worktree of the clone that has a task with slug s",
      "when": "dotbabel task new s runs in another worktree of the clone",
      "then": "it exits 1 and writes no task",
      "tests": [
        {
          "file": "plugins/dotbabel/tests/task-cli.test.mjs",
          "name": "task new refuses a slug that another worktree of the clone uses"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/task-cli.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-2.junit.xml"
      ],
      "report": {
        "format": "junit-xml",
        "path": ".dotbabel/criteria/AC-2.junit.xml"
      }
    },
    {
      "id": "AC-3",
      "status": "active",
      "given": "task b depends on task a",
      "when": "dotbabel task update a --depends-on b runs",
      "then": "it exits 1 and writes no change",
      "tests": [
        {
          "file": "plugins/dotbabel/tests/task-cli.test.mjs",
          "name": "task update refuses an edge that closes a cycle"
        }
      ],
      "argv": [
        "npx",
        "vitest",
        "run",
        "plugins/dotbabel/tests/task-cli.test.mjs",
        "--reporter=junit",
        "--outputFile=.dotbabel/criteria/AC-3.junit.xml"
      ],
      "report": {
        "format": "junit-xml",
        "path": ".dotbabel/criteria/AC-3.junit.xml"
      }
    },
    {
      "id": "AC-4",
      "status": "active",
      "given": "open task a, and open task b that depends on a",
