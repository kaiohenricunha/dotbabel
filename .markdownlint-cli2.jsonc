{
  "config": {
    "default": true,
    "MD004": false,
    "MD012": { "maximum": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD031": false,
    "MD033": { "allowed_elements": ["details", "summary", "kbd", "br", "sub", "sup", "previous", "current_status", "value", "url", "read-first"] },
    "MD036": false,
    "MD060": false,
    "MD040": false,
    "MD041": false
  },
  "ignores": [
    "node_modules/**",
    ".claude/worktrees/**",
    "plugins/dotbabel/tests/fixtures/**",
    "commands/**",
    "skills/**",
    ".claude/commands/**",
    ".claude/skills/**",
    // Verbatim upstream copy of cloudflare/security-audit-skill (hash-pinned by
    // scripts/sync-security-audit.mjs). Any path: the templates and example copies,
    // and the .opencode/.cli/.agents fan-out symlinks that lead back to it.
    "**/security-audit/references/upstream/**"
  ]
}
