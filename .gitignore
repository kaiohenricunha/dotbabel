# Local-only Claude state — never commit.
.claude/worktrees/
settings.local.json
**/settings.local.json
*.local.json
**/claude.log
**/logs/
**/.DS_Store

# Local working plans — transient, not for distribution.
docs/plans/

# local-attest audit trail. Per-machine (it records a hostname), and leaving it
# untracked breaks the tool: the run appends here, which dirties the worktree,
# and the next `local-attest` aborts on its own output with WORKTREE_DIRTY.
.local-attest-log.jsonl

# Articles — written locally, published elsewhere, not versioned here.
docs/articles/

# Assessment docs — graded locally, not for distribution.
docs/assessments/

# Node (for the plugin workspace)
node_modules/
*.log
.env
.env.local
coverage/
dist/

# Editor noise
.vscode/
.idea/
*.swp
